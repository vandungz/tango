generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========== AUTH MODELS ==========

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  displayName   String?
  email         String    @unique
  password      String
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  dailyResults   DailyResult[]
  journeyResults JourneyResult[]

  @@index([email])
  @@index([username])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String   // email
  token      String   @unique
  type       String   // "email_verification" | "password_reset"
  metadata   String?  // JSON: pending registration data (username, hashedPassword)
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token, type])
  @@index([identifier, type])
}

// ========== GAME MODELS ==========

model Puzzle {
  id         String   @id @default(cuid())
  size       Int
  hash       String   @unique
  board      String   // JSON: initial board with blanks
  solution   String   // JSON: complete solution
  clues      String   // JSON: clue array
  difficulty Int
  maxRuleDifficulty Int    @default(0)
  rulesUsed          String @default("[]") // JSON: solver rule names used in solve pass
  clueCount          Int    @default(0)
  givensCount        Int    @default(0)
  baseRowPatternCount Int   @default(0)
  generationVersion  String @default("pipeline-v1")
  solverVersion      String @default("rule-engine-v1")
  label      String   // Easy, Medium, Hard, Very Hard
  createdAt  DateTime @default(now())

  playedBy      PlayedPuzzle[]
  daily         DailyPuzzle?
  journeyLevels JourneyLevel[]

  @@index([size, label])
}

model PlayedPuzzle {
  id        String   @id @default(cuid())
  sessionId String
  puzzleId  String
  playedAt  DateTime @default(now())

  puzzle Puzzle @relation(fields: [puzzleId], references: [id])

  @@unique([sessionId, puzzleId])
  @@index([sessionId])
}

model DailyPuzzle {
  id        String   @id @default(cuid())
  date      DateTime
  size      Int      @default(6)
  proMode   Boolean  @default(false)
  puzzleId  String   @unique
  createdAt DateTime @default(now())

  puzzle  Puzzle      @relation(fields: [puzzleId], references: [id])
  results DailyResult[]

  @@unique([date, size, proMode])
  @@index([date, proMode])
}

model DailyResult {
  id              String   @id @default(cuid())
  sessionId       String?
  userId          String?
  dailyPuzzleId   String
  durationSeconds Int
  stars           Int
  completedAt     DateTime @default(now())

  daily DailyPuzzle @relation(fields: [dailyPuzzleId], references: [id])
  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, dailyPuzzleId])
  @@unique([userId, dailyPuzzleId])
  @@index([userId])
  @@index([sessionId])
}

model JourneySet {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  totalLevels Int
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?

  levels JourneyLevel[]

  @@index([isActive])
}

model JourneyLevel {
  id        String   @id @default(cuid())
  setId     String
  order     Int
  puzzleId  String
  createdAt DateTime @default(now())

  set    JourneySet      @relation(fields: [setId], references: [id])
  puzzle  Puzzle         @relation(fields: [puzzleId], references: [id])
  results JourneyResult[]

  @@unique([setId, order])
  @@unique([setId, puzzleId])
  @@index([setId, order])
}

model JourneyResult {
  id          String   @id @default(cuid())
  sessionId   String?
  userId      String?
  levelId     String
  timeSeconds Int
  stars       Int
  completedAt DateTime @default(now())

  level JourneyLevel @relation(fields: [levelId], references: [id])
  user  User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, levelId])
  @@unique([userId, levelId])
  @@index([userId])
  @@index([sessionId])
}
